NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/way_education?schema=public
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
# Set this to the public backend URL when frontend and backend use different origins.
PUBLIC_API_URL=http://localhost:8000
# On Render, point this at a persistent disk, for example /var/data/media.
MEDIA_STORAGE_PATH=
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Way Education <noreply@example.com>
ADMIN_EMAIL=admin@wayeducation.com
# Used only to create the initial admin account. It does not reset an existing account.
ADMIN_PASSWORD=replace-with-a-unique-admin-password
